<UserControl x:Class="FlyleafLib.Controls.WPF.PlayerDebug"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FlyleafLib.Controls.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:FlyleafHost}"
             d:DesignHeight="600" d:DesignWidth="800" x:Name="DebugControl" d:Background="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <loc:UiValueConverter x:Key="LocalizedValue" />
            <local:TicksToTimeSpanConverter x:Key="TicksToTimeSpan"/>
            <local:TicksToMilliSecondsConverter x:Key="TicksToMilliSeconds"/>
            <local:DeInterlaceConverter x:Key="DeInterlaceConverter"/>
            <local:EqualityConverter x:Key="EqualityConverter"/>

            <Style x:Key="FlowTable" TargetType="StackPanel">
                <Setter Property="Background" Value="{Binding BoxColor, ElementName=DebugControl}"/>
                <Setter Property="Width" Value="340"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0 10 10 0"/>
            </Style>

            <Style x:Key="TextHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Courier New" />
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Foreground" Value="{Binding HeaderColor, ElementName=DebugControl}"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Margin" Value="0 5 0 10"/>
            </Style>

            <Style x:Key="TextInfo" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Courier New" />
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Width" Value="180"/>
                <Setter Property="Foreground" Value="{Binding InfoColor, ElementName=DebugControl}"/>
                <Setter Property="Margin" Value="10 0 0 0"/>
            </Style>

            <Style x:Key="TextValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Courier New" />
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{Binding ValueColor, ElementName=DebugControl}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Width" Value="140"/>
                <Setter Property="MaxHeight" Value="92"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>

        <TextBlock x:Name="SelectedTitle" HorizontalAlignment="Left" Background="{Binding BoxColor, ElementName=DebugControl}" Padding="10" Width="690" TextWrapping="Wrap" Text="{Binding Player.Playlist.Selected.Title}">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource TextValue}" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                    <Binding Path="Player.Playlist.Url"/>
                                    <Binding Path="Text" ElementName="SelectedTitle"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock HorizontalAlignment="Left" Background="{Binding BoxColor, ElementName=DebugControl}" Style="{StaticResource TextValue}" Padding="10" Width="690" TextWrapping="Wrap" FontSize="12" Text="{Binding Player.Playlist.Url}"/>

        <Grid x:Name="rootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel>
                <!-- Player -->
                <StackPanel Style="{StaticResource FlowTable}" Height="310">
                    <TextBlock Style="{StaticResource TextHeader}" Text="{loc:Text Key=Text_64AEE8C6CBD026D9}"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_440C0677B0D06CCF}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.CurTime, Converter={StaticResource TicksToTimeSpan}, StringFormat={}{0:hh\\:mm\\:ss\\.fff}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_4FC52A3C4C558B51}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Duration, Converter={StaticResource TicksToTimeSpan}, StringFormat={}{0:hh\\:mm\\:ss\\.fff}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_E44193FD2D21722A}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.BufferedDuration, Converter={StaticResource TicksToTimeSpan}, StringFormat={}{0:hh\\:mm\\:ss\\.fff}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_920E413C7D411B61}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Status, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_B64AC05F17E64D03}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.IsLive, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_E2108EB7FD2063AE}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Host.IsFullScreen, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_80E8DD1A5A05F707}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.IsRecording, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_0B4D337CAAD6A9E4}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.ReversePlayback, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_E551B1F1B22A75D5}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Config.Video.DeInterlace, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_C372FEE9B4566B85}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Speed, StringFormat=x{0}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_CA102D70E822B9A5}"/>
                        <TextBlock Style="{StaticResource TextValue}">
                            <TextBlock Style="{StaticResource TextValue}">
                                <Run Text="{Binding Player.Config.Video.PanXOffset, Mode=OneWay}"/>
                                <Run Text="|"/>
                                <Run Text="{Binding Player.Config.Video.PanYOffset, Mode=OneWay}"/>
                            </TextBlock>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_57B5E2FC1BBA18BB}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Config.Video.Rotation}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_509C517EDE79FEF0}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Config.Video.Zoom}"/>
                    </StackPanel>

                </StackPanel>

                <!-- Audio (Manual Height-->
                <StackPanel Style="{StaticResource FlowTable}" Height="300">
                    <TextBlock Style="{StaticResource TextHeader}" Text="{loc:Text Key=Text_BC1B88907D3B748A}"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_92C1CDFDF4CB9CF6}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Config.Audio.Enabled, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_B19FB8D1B395B333}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.IsOpened, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_FD9B6DF3CDBC3D35}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Config.Audio.Delay, Converter={StaticResource TicksToMilliSeconds}, StringFormat={}{0} ms}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_B10FB966D72063F5}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.Volume, StringFormat={}{0}%}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_8DD6857BAF026850}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.Mute, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_6BA0BDECCB426D7B}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.Device}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_E184853401081B4F}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.Codec}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_4C8906CF76F5740A}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.Channels}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_72BFC52235E71BFA}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.ChannelLayout}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_3A4AB4F72DC5080D}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.SampleFormat}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_B4FC34F52A5E725A}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.SampleRate, StringFormat={}{0:N0} Hz}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <!-- Video -->
                <StackPanel Style="{StaticResource FlowTable}" Height="310">
                    <TextBlock Style="{StaticResource TextHeader}" Text="{loc:Text Key=Text_D534BE829E32196B}"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_92C1CDFDF4CB9CF6}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Config.Video.Enabled, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_B19FB8D1B395B333}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.IsOpened, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_E184853401081B4F}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.Codec}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_1AF851907331C0ED}"/>
                        <TextBlock Style="{StaticResource TextValue}">
                            <Run Text="{Binding Player.Video.Width, Mode=OneWay}"/>
                            <Run Text="x"/>
                            <Run Text="{Binding Player.Video.Height, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_556F85EFA2BEEC52}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.AspectRatio, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_33F69A34D4EB1540}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.PixelFormat}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_7151272941560B0C}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.ColorFormat}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_2DF9E7D0461D2DC9}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.FPS, StringFormat={}{0:F2}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_FE8C0AE45A6AC361}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.FramesTotal, StringFormat={}{0:N0}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_E551B1F1B22A75D5}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Renderer.FieldType, Converter={StaticResource DeInterlaceConverter}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_706D3555857D1C9A}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Renderer.SuperResolution, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_91663A8E5FA01CD7}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.VideoAcceleration, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_54AAC653F06E8F29}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Renderer.VideoProcessor, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Subtitles -->
                <StackPanel  Style="{StaticResource FlowTable}">
                    <TextBlock Style="{StaticResource TextHeader}" Text="{loc:Text Key=Text_0EE695BDEB26A296}"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_92C1CDFDF4CB9CF6}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Config.Subtitles.Enabled, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_B19FB8D1B395B333}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Subtitles[0].IsOpened, Converter={StaticResource LocalizedValue}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_FD9B6DF3CDBC3D35}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Config.Subtitles[0].Delay, Converter={StaticResource TicksToMilliSeconds}, StringFormat={}{0} ms}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_E184853401081B4F}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Subtitles[0].Codec}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_74D53A496F3E08EA}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Subtitles[0].Data.Text}" Margin="-90 0 0 0" Width="225"/>
                    </StackPanel>
                </StackPanel>

                <!-- Stats -->
                <StackPanel Style="{StaticResource FlowTable}" Height="152">
                    <TextBlock Style="{StaticResource TextHeader}" Text="{loc:Text Key=Text_B4A7365740EF880B}"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_2DF9E7D0461D2DC9}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.FPSCurrent, StringFormat={}{0:F2}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_17D8FF0B717D0939}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.FramesDisplayed, StringFormat={}{0:N0}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_0F1FE9597EE0F027}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.FramesDropped, StringFormat={}{0:N0}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_97F9FDB59F828152}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.BitRate, StringFormat={}{0:N0} Kbps}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_5E364E6FD37F8138}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Video.BitRate, StringFormat={}{0:N0} Kbps}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                        <TextBlock Style="{StaticResource TextInfo}" Text="{loc:Text Key=Text_52C19F8FCD1A44BB}"/>
                        <TextBlock Style="{StaticResource TextValue}" Text="{Binding Player.Audio.BitRate, StringFormat={}{0:N0} Kbps}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
