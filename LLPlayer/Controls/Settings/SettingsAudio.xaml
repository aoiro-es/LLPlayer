<UserControl x:Class="LLPlayer.Controls.Settings.SettingsAudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SettingsAudioVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_BC1B88907D3B748A}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_BC1B88907D3B748A}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_92C1CDFDF4CB9CF6}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Audio.Enabled}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_6F56A613C104A2D3}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Audio.FiltersEnabled}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_199702C3A0B38E34}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Audio.Delay, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Int"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_F3D0E6F92695FAE5}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Audio.VolumeMax}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_712C9D31DFCC0152}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Audio.VolumeDefault}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_7C15BF119B5D9827}">
                <StackPanel>
                    <ListBox
                        ItemsSource="{Binding FL.PlayerConfig.Audio.Languages}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" >
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedTextConv}}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        HorizontalAlignment="Left"
                        Margin="0 15 0 0"
                        MaxWidth="150"
                        Content="{loc:Text Key=Text_6DEFAFA2CAA65304}"
                        Command="{Binding CmdConfigureLanguage}" />

                    <TextBlock Margin="5 10 5 0">
                        <Run Text="{loc:Text Key=Text_908D0E0B201B5A7A}" />
                        <LineBreak />
                        <Run Text="{loc:Text Key=Text_6B69792DAABF25F7}" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_4BA5121D4D1BE174}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_2ACD09A86693C652}" />
                        <TextBlock
                            Text="{Binding FL.AudioEngine.CurrentDevice.Name}" />
                    </DockPanel>

                    <DockPanel>
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_6BA0BDECCB426D7B}" />
                        <ComboBox
                            ItemsSource="{Binding FL.AudioEngine.Devices}"
                            SelectedItem="{Binding FL.Player.Audio.Device}"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
