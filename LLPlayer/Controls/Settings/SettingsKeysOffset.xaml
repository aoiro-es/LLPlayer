<UserControl x:Class="LLPlayer.Controls.Settings.SettingsKeysOffset"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_55F1934C3B1F911E}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_64AEE8C6CBD026D9}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_0A1EEF26CAC3058C}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.SpeedOffset}"
                            helpers:TextBoxHelper.OnlyNumeric="Double" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_86E3196E04CFCCFD}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.SpeedOffset2}"
                            helpers:TextBoxHelper.OnlyNumeric="Double" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_BC1B88907D3B748A}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_621B9D7818D448DA}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Audio.VolumeOffset}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_E7FF3A474AF03D88}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Audio.DelayOffset, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_0FEDFD3E47E91300}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Audio.DelayOffset2, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_0EE695BDEB26A296}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_E8128F05BA9DD6A8}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Subtitles.DelayOffset, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_0FEDFD3E47E91300}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Subtitles.DelayOffset2, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_84E35237CF5ED951}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_CFB014A89F027CA6}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsPositionOffset}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_1A3BF9C9F73509FC}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsFontSizeOffset}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_AA797F38221E9488}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsBitmapScaleOffset}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_4DFF8A89565B1222}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsDistanceOffset}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_67AE3405BCD4DF1F}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_78D65A2104E76098}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.SeekOffset, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                        <CheckBox
                            Margin="15 0 0 0"
                            IsChecked="{Binding FL.PlayerConfig.Player.SeekOffsetAccurate}"
                            Content="{loc:Text Key=Text_E6F9742F068A779B}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_B2C13FCEBD5875F7}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.SeekOffset2, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                        <CheckBox
                            Margin="15 0 0 0"
                            IsChecked="{Binding FL.PlayerConfig.Player.SeekOffsetAccurate2}"
                            Content="{loc:Text Key=Text_E6F9742F068A779B}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_6875A2924A7BAD3B}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.SeekOffset3, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                        <CheckBox
                            Margin="15 0 0 0"
                            IsChecked="{Binding FL.PlayerConfig.Player.SeekOffsetAccurate3}"
                            Content="{loc:Text Key=Text_E6F9742F068A779B}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_F70E55EDAD2C7DBE}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.SeekOffset4, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                        <CheckBox
                            Margin="15 0 0 0"
                            IsChecked="{Binding FL.PlayerConfig.Player.SeekOffsetAccurate4}"
                            Content="{loc:Text Key=Text_E6F9742F068A779B}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_D534BE829E32196B}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                        Width="180"
                        Text="{loc:Text Key=Text_FEE3D4B2A319F707}" />
                        <TextBox
                        Width="100"
                        Text="{Binding FL.PlayerConfig.Video.ZoomOffset}"
                        helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
