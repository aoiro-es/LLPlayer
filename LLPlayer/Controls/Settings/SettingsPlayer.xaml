<UserControl x:Class="LLPlayer.Controls.Settings.SettingsPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings"
             xmlns:ffmpeg="clr-namespace:Flyleaf.FFmpeg;assembly=Flyleaf.FFmpeg.Bindings"
             xmlns:flyleaf="clr-namespace:FlyleafLib;assembly=FlyleafLib"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="LogLevelEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="flyleaf:LogLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="FFmpegLogLevelEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ffmpeg:LogLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="FFmpegLoadProfileEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ffmpeg:LoadProfile"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_64AEE8C6CBD026D9}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_6B7469B0733E6055}" Margin="0 0 0 12">
                <StackPanel>
                    <ComboBox Width="220" HorizontalAlignment="Left" SelectedValuePath="Tag"
                              SelectedValue="{Binding FL.Config.UiLanguage}">
                        <ComboBoxItem Content="日本語" Tag="ja-JP" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                    <TextBlock Text="{loc:Text Key=Text_829F118DB2989104}" TextWrapping="Wrap" Margin="0 8 0 0" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="{loc:Text Key=Text_64AEE8C6CBD026D9}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_79D9F95498818301}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.MinBufferDuration, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_47EFA6C8CB356B7B}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Demuxer.BufferDuration, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_09544BE7E8A57D86}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Decoder.MaxAudioFrames}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_17CF669933DF3C17}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Decoder.MaxVideoFrames}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_87C8F337FA56523F}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Video.MaxVerticalResolutionCustom}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"
                            ToolTip="{loc:Text Key=Text_706C8B20C6E31CE0}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_FB71A38D1E99E401}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_9FD5A3E24759616B}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{loc:Text Key=Text_014389638886890D}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.ActivityTimeout}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_8457969D0AC8E37B}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{loc:Text Key=Text_898E7A569C408059}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <ToggleButton
                            IsChecked="{Binding FL.Config.SeekBarShowOnlyMouseOver}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_3ECF0734C0889449}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.SeekBarFadeInTimeMs}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_AF459BC4C013A121}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.SeekBarFadeOutTimeMs}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_7618F7FCD2212369}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.SeekBarHeight}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_6EFCAB2F70DC3C47}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.SeekBarThumbHeight}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_B40BADEB87780401}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.SeekBarTrackHeight}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Text="{loc:Text Key=Text_7E8F0B964D60B91B}"
                            Width="180">
                        </TextBlock>
                        <ToggleButton
                            IsChecked="{Binding FL.Config.AlwaysOnTop}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_A79078D6CEB3244A}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_AAE11583EAC37DA8}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Demuxer.OpenTimeout, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_486C9995037C1E8B}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Demuxer.ReadTimeout, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_133890C16F762906}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Demuxer.ReadLiveTimeout, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_86B4A54B0F5E9429}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Demuxer.SeekTimeout, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_67AE3405BCD4DF1F}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_5933B58FE08C2CF0}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Player.SeekAccurate}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_79F3931B5306E7B2}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.SeekAccurateFixMargin, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_D3EF01B4A9C99103}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_60DC97C2B0458B8E}" />
                        <TextBox
                            HorizontalContentAlignment="Left"
                            Text="{Binding FL.ConfigEngine.LogOutput}" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_12FE4737438F3BDB}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource LogLevelEnum}}"
                            SelectedItem="{Binding FL.ConfigEngine.LogLevel}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_11017BFA786D30DD}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource FFmpegLogLevelEnum}}"
                            SelectedItem="{Binding FL.ConfigEngine.FFmpegLogLevel}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_578CA20E98A7CA19}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.ConfigEngine.LogCachedLines}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="FFmpeg">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_F876D18134315776}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource FFmpegLoadProfileEnum}}"
                            SelectedItem="{Binding FL.ConfigEngine.FFmpegLoadProfile}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
