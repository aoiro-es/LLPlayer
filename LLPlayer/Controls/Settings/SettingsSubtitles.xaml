<UserControl x:Class="LLPlayer.Controls.Settings.SettingsSubtitles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:LLPlayer.Controls.Settings.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SettingsSubtitlesVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_0EE695BDEB26A296}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_0EE695BDEB26A296}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_92C1CDFDF4CB9CF6}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Subtitles.Enabled}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_1C50AD2822B2DCEB}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        MaxWidth="400">
                                        <Run Text="{loc:Text Key=Text_CC8DFFAA21B894CF}"/>
                                        <LineBreak />
                                        <LineBreak /><Run Text="- video.srt" />
                                        <LineBreak /><Run Text="{loc:Text Key=Text_3BFF4D971DB77AAB}" />
                                        <LineBreak /><Run Text="{loc:Text Key=Text_8C0F929BA7130549}" />
                                        <LineBreak /><Run Text="{loc:Text Key=Text_DF40182FD1B06B52}" />
                                        <LineBreak /><Run Text="- path\video.srt" />
                                    </TextBlock>
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                                </InlineUIContainer>
                        </TextBlock>
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Subtitles.SearchLocal}" />
                    </StackPanel>

                    <DockPanel Visibility="{Binding FL.PlayerConfig.Subtitles.SearchLocal, Converter={StaticResource BooleanToVisibilityConv}}">
                        <TextBlock
                            Width="180">
                          <Run Text="{loc:Text Key=Text_FEC34606161EC115}" />
                           <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                               <ToolTipService.ToolTip>
                                   <TextBlock
                                       Text="{loc:Text Key=Text_8BC990ACEAC92D74}"
                                       TextWrapping="Wrap"
                                       MaxWidth="400" />
                               </ToolTipService.ToolTip>
                               <materialDesign:PackIcon
                                   Kind="Information"
                                   Width="16" Height="16"
                                   Margin="4 0 0 0" />
                           </InlineUIContainer>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                HorizontalContentAlignment="Left"
                                Text="{Binding FL.PlayerConfig.Subtitles.SearchLocalPaths}" />
                            <Button
                                Grid.Column="1"
                                Margin="10 0 0 0"
                                ToolTip="{loc:Text Key=Text_BC5B45AE7B60692A}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                HorizontalAlignment="Center"
                                Width="24"
                                Height="24"
                                Command="{Binding FL.PlayerConfig.Subtitles.CmdResetSearchLocalPaths}">
                                <materialDesign:PackIcon Kind="BackupRestore" />
                            </Button>
                        </Grid>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_1E1B04AD78D942DE}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{loc:Text Key=Text_B5B03E9D8175AE1D}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Subtitles.EnabledCached}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_5DE3AAC4D7AD6046}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{loc:Text Key=Text_19438E9CB71730DC}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Subtitles.OpenAutomaticSubs}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_5B7E28EFCBC9A1CE}" />
                        <ToggleButton
                            IsChecked="{Binding FL.Config.Subs.SubsExportUTF8WithBom}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_DB0388CEA2E9C8EC}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Subtitles[0].Delay, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Int"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_AAF424C55F907EB0}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Subtitles[1].Delay, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Int"/>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_5C5C0418D95D9DCA}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_F71A2C787A26EA06}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsFontSize}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_C1166C3DD8EFC54E}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsFontSize2}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                        <Button
                            Margin="10 0 0 0"
                            ToolTip="{loc:Text Key=Text_8A9B241F1978E5F7}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            HorizontalAlignment="Center"
                            Width="24"
                            Height="24"
                            Command="{Binding FL.Config.Subs.CmdResetSubsFontSize2}">
                            <materialDesign:PackIcon Kind="BackupRestore" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_3680FCAD01F4BFC6}" />
                        <Button
                            Height="auto"
                            MaxHeight="100"
                            Command="{Binding FL.Action.CmdSetSubtitlesFont}">
                            <TextBlock TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center">
                                <Run Text="{Binding FL.Config.Subs.SubsFontFamily}"/>
                                <Run Text="("/>
                                <Run Text="{Binding FL.Config.Subs.SubsFontWeight}"/>
                                <Run Text="), "/>
                                <Run Text="{Binding FL.Config.Subs.SubsFontSize}"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_B3567E7A38053769}" />
                        <Button
                            Background="{x:Null}"
                            Padding="0"
                            BorderThickness="0"
                            Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                            <Button.CommandParameter>
                                <controls:ColorPicker PickerColor="{Binding FL.Config.Subs.SubsFontColor, Mode=TwoWay}" />
                            </Button.CommandParameter>
                            <Rectangle
                                Fill="{Binding FL.Config.Subs.SubsFontColor, Converter={StaticResource ColorToBrushConv}}"
                                Width="30"
                                Height="30" />
                        </Button>
                        <TextBlock Margin="10 0 0 0" Text="#" />
                        <TextBox Width="55" MaxLength="6" helpers:TextBoxMiscHelper.IsHexValidationEnabled="True">
                            <TextBox.Text>
                                <Binding
                                    Path="FL.Config.Subs.SubsFontColor"
                                    Converter="{StaticResource ColorToHexConv}"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <StaticResource ResourceKey="ColorHexRule" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_E4CE5735873D5D8B}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsStrokeThickness}"
                            helpers:TextBoxHelper.OnlyNumeric="Double"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_F4A56A2B10E3B873}" />
                        <Button
                            Background="{x:Null}"
                            Padding="0"
                            BorderThickness="0"
                            Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                            <Button.CommandParameter>
                                <controls:ColorPicker PickerColor="{Binding FL.Config.Subs.SubsStrokeColor, Mode=TwoWay}" />
                            </Button.CommandParameter>
                            <Rectangle
                                Fill="{Binding FL.Config.Subs.SubsStrokeColor, Converter={StaticResource ColorToBrushConv}}"
                                Width="30"
                                Height="30" />
                        </Button>
                        <TextBlock Margin="10 0 0 0" Text="#" />
                        <TextBox Width="55" MaxLength="6" helpers:TextBoxMiscHelper.IsHexValidationEnabled="True">
                            <TextBox.Text>
                                <Binding
                                    Path="FL.Config.Subs.SubsStrokeColor"
                                    Converter="{StaticResource ColorToHexConv}"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <StaticResource ResourceKey="ColorHexRule" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_B48BC969E914F8C9}" />
                        <Button
                            Background="{x:Null}"
                            Padding="0"
                            BorderThickness="0"
                            Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                            <Button.CommandParameter>
                                <controls:ColorPicker PickerColor="{Binding FL.Config.Subs.SubsBackgroundColor, Mode=TwoWay}" />
                            </Button.CommandParameter>
                            <Rectangle
                                Fill="{Binding FL.Config.Subs.SubsBackgroundColor, Converter={StaticResource ColorToBrushConv}}"
                                Width="30"
                                Height="30" />
                        </Button>
                        <TextBlock Margin="10 0 0 0" Text="#" />
                        <TextBox Width="55" MaxLength="6" helpers:TextBoxMiscHelper.IsHexValidationEnabled="True">
                            <TextBox.Text>
                                <Binding
                                    Path="FL.Config.Subs.SubsBackgroundColor"
                                    Converter="{StaticResource ColorToHexConv}"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <StaticResource ResourceKey="ColorHexRule" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_47AF11BD5E415745}" />
                        <Slider
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding FL.Config.Subs.SubsBackgroundOpacity,
                                Converter={StaticResource DoubleToPercentageConv}}"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignDiscreteSlider}"
                            materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                            TickFrequency="1"
                            Width="200" />
                        <TextBox
                            Width="30"
                            Margin="4 0 0 0"
                            Text="{Binding FL.Config.Subs.SubsBackgroundOpacity,
                                 Converter={StaticResource DoubleToPercentageConv}, UpdateSourceTrigger=PropertyChanged}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                        <TextBlock Text="%" Margin="2 0 0 0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_5E1A9841AC53F2EF}" />
                        <ToggleButton
                            IsChecked="{Binding FL.Config.Subs.SubsUseSeparateFonts}" />
                    </StackPanel>

                    <Border
                        Padding="10"
                        Visibility="{Binding FL.Config.Subs.SubsUseSeparateFonts, Converter={StaticResource BooleanToVisibilityConv}}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}">

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="180"
                                    Text="{loc:Text Key=Text_00100AD46EE19373}" />
                                <Button
                                    Height="auto"
                                    MaxHeight="100"
                                    Command="{Binding FL.Action.CmdSetSubtitlesFont2}">
                                    <TextBlock TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center">
                                        <Run Text="{Binding FL.Config.Subs.SubsFontFamily2}"/>
                                        <Run Text="("/>
                                        <Run Text="{Binding FL.Config.Subs.SubsFontWeight2}"/>
                                        <Run Text="), "/>
                                        <Run Text="{Binding FL.Config.Subs.SubsFontSize2}"/>
                                    </TextBlock>
                                </Button>

                                <Button
                                    Margin="6 0 0 0"
                                    ToolTip="{loc:Text Key=Text_8A9B241F1978E5F7}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    HorizontalAlignment="Center"
                                    Width="24"
                                    Height="24"
                                    Command="{Binding FL.Config.Subs.CmdResetSubsFont2}">
                                    <materialDesign:PackIcon Kind="BackupRestore" />
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                                <TextBlock
                                    Width="180"
                                    Text="{loc:Text Key=Text_8BFCFE82B9F28E0D}" />
                                <Button
                                    Background="{x:Null}"
                                    Padding="0"
                                    BorderThickness="0"
                                    Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                                    <Button.CommandParameter>
                                        <controls:ColorPicker PickerColor="{Binding FL.Config.Subs.SubsFontColor2, Mode=TwoWay}" />
                                    </Button.CommandParameter>
                                    <Rectangle
                                        Fill="{Binding FL.Config.Subs.SubsFontColor2, Converter={StaticResource ColorToBrushConv}}"
                                        Width="30"
                                        Height="30" />
                                </Button>
                                <TextBlock Margin="10 0 0 0" Text="#" />
                                <TextBox Width="55" MaxLength="6" helpers:TextBoxMiscHelper.IsHexValidationEnabled="True">
                                    <TextBox.Text>
                                        <Binding
                                        Path="FL.Config.Subs.SubsFontColor2"
                                        Converter="{StaticResource ColorToHexConv}"
                                        UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <StaticResource ResourceKey="ColorHexRule" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <Button
                                    Margin="6 0 0 0"
                                    ToolTip="{loc:Text Key=Text_8A9B241F1978E5F7}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    HorizontalAlignment="Center"
                                    Width="24"
                                    Height="24"
                                    Command="{Binding FL.Config.Subs.CmdResetSubsFontColor2}">
                                    <materialDesign:PackIcon Kind="BackupRestore" />
                                </Button>

                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="180"
                                    Text="{loc:Text Key=Text_7B41C7FF336880E9}" />
                                <Slider
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding FL.Config.Subs.SubsBackgroundOpacity2,
                                Converter={StaticResource DoubleToPercentageConv}}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignDiscreteSlider}"
                                    materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                                    TickFrequency="1"
                                    Width="200" />
                                <TextBox
                                    Width="30"
                                    Margin="4 0 0 0"
                                    Text="{Binding  FL.Config.Subs.SubsBackgroundOpacity2,
                                 Converter={StaticResource DoubleToPercentageConv}, UpdateSourceTrigger=PropertyChanged}"
                                    helpers:TextBoxHelper.OnlyNumeric="Uint" />
                                <TextBlock Text="%" Margin="2 0 0 0" />

                                <Button
                                    Margin="6 0 0 0"
                                    ToolTip="{loc:Text Key=Text_8A9B241F1978E5F7}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    HorizontalAlignment="Center"
                                    Width="24"
                                    Height="24"
                                    Command="{Binding FL.Config.Subs.CmdResetSubsBackgroundOpacity2}">
                                    <materialDesign:PackIcon Kind="BackupRestore" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_86D7E8AD5A692608}">
                <StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_FCD71439D781EB63}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{loc:Text Key=Text_311B9009B14313B2}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <ToggleButton
                        IsChecked="{Binding FL.PlayerConfig.Subtitles.LanguageAutoDetect}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                        Width="180"
                        Text="{loc:Text Key=Text_37E17259764AC93B}" />

                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedPrimaryLanguage}" >
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedTextConv}}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel>

                    <!--TODO: L: Support for forced settings instead of fallback -->
                    <!--TODO: L: Display various language settings in the debug window-->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                        Width="180"
                        Text="{loc:Text Key=Text_D153E8139304DE49}" />

                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding Languages}"
                            IsEnabled="{Binding FL.PlayerConfig.Subtitles.LanguageFallbackSecondarySame, Converter={StaticResource InvertBooleanConv}}"
                            SelectedItem="{Binding SelectedSecondaryLanguage}" >
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedTextConv}}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                        <CheckBox
                            Margin="15 0 0 0"
                            IsChecked="{Binding FL.PlayerConfig.Subtitles.LanguageFallbackSecondarySame}"
                            Content="{loc:Text Key=Text_64A91F874E1D1AD2}" />

                    </StackPanel>
                </StackPanel>

            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_12A0FE66935CECCB}">
                <StackPanel>
                    <ListBox
                        ItemsSource="{Binding FL.PlayerConfig.Subtitles.Languages}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" >
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedTextConv}}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        HorizontalAlignment="Left"
                        Margin="0 15 0 0"
                        MaxWidth="150"
                        Content="{loc:Text Key=Text_6DEFAFA2CAA65304}"
                        Command="{Binding CmdConfigureLanguage}" />

                    <TextBlock Margin="5 10 5 0">
                        <Run Text="{loc:Text Key=Text_C619D125A94FB895}" />
                        <LineBreak />
                        <Run Text="{loc:Text Key=Text_8C17353F6292E746}" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_3D3D0BBC581667E2}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_04EFAE3FC7825D3A}" />
                        <ToggleButton
                            IsChecked="{Binding FL.Config.ShowSidebar}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_65B424FD887417C3}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.SidebarWidth}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_FD290E408C660D85}" />
                        <ToggleButton
                            IsChecked="{Binding FL.Config.SidebarLeft}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_EECDC898F3E23B9B}" />
                        <ToggleButton
                            IsChecked="{Binding FL.Config.SidebarTextMask}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_518C64821D1C3079}" />
                        <ToggleButton
                            IsChecked="{Binding FL.Config.SidebarShowOriginalText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_A07A34BC2DA727A5}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.SidebarSubPadding}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_3680FCAD01F4BFC6}" />

                        <Button
                            Height="auto"
                            MaxHeight="100"
                            Command="{Binding FL.Action.CmdSetSubtitlesFontSidebar}">
                            <TextBlock TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center">
                                <Run Text="{Binding FL.Config.SidebarFontFamily}"/>
                                <Run Text="("/>
                                <Run Text="{Binding FL.Config.SidebarFontWeight}"/>
                                <Run Text="), "/>
                                <Run Text="{Binding FL.Config.SidebarFontSize}"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
