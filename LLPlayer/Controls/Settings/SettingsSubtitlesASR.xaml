                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Width="200">
                                        <Run Text="{loc:Text Key=Text_3E42E385075B9B56}" />
                                        <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                            <ToolTipService.ToolTip>
                                                <TextBlock
                                                    Text="{loc:Text Key=Text_4D48A7281E0F2003}"
