                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Width="200">
                                        <Run Text="{loc:Text Key=Text_9A3885CE413421D2}" />
                                        <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                            <ToolTipService.ToolTip>
                                                <TextBlock
                                                    Text="{loc:Text Key=Text_A5374A7055D4FE09}"
                                                    TextWrapping="Wrap"
                                                    MaxWidth="400" />
                                            </ToolTipService.ToolTip>
                                            <materialDesign:PackIcon
                                                Kind="Information"
                                                Width="16" Height="16"
                                                Margin="4 0 0 0" />
                                        </InlineUIContainer>
                                    </TextBlock>
                                    <ComboBox
