<UserControl x:Class="LLPlayer.Controls.Settings.SettingsSubtitlesAction"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:flyleafServices="clr-namespace:FlyleafLib.MediaPlayer.Translation.Services;assembly=FlyleafLib"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:LLPlayer.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SettingsSubtitlesActionVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="TranslateServiceTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="flyleafServices:TranslateServiceType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="SubAutoTextCopyTargetEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="services:SubAutoTextCopyTarget"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <local:TranslateServiceTypeEnumToStringConverter x:Key="TranslateServiceTypeEnumToStringConv" />
        <local:TranslateServiceTypeEnumToUrlConverter x:Key="TranslateServiceTypeEnumToUrlConv" />
</UserControl.Resources>

    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_E31714B8DA13D1D1}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_6EB3B6E376329E09}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Width="180">
                            <Hyperlink Style="{StaticResource MyHyperLink}" NavigateUri="{Binding FL.PlayerConfig.Subtitles.TranslateWordServiceType, Converter={StaticResource TranslateServiceTypeEnumToUrlConv}}" helpers:HyperlinkHelper.OpenInBrowser="True">
                                <Run Text="{loc:Text Key=Text_1CA478B19DC534F6}" />
                            </Hyperlink>
                        </TextBlock>
                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding Source={StaticResource TranslateServiceTypeEnum}}"
                            SelectedItem="{Binding FL.PlayerConfig.Subtitles.TranslateWordServiceType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TranslateServiceTypeEnumToStringConv}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{loc:Text Key=Text_951910C77882FB95}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_4291B626D7FF5C9F}">
                <StackPanel>
                    <CheckBox
                        IsChecked="{Binding FL.Config.Subs.WordCopyOnSelected}"
                        Content="{loc:Text Key=Text_43B34ACB35F76CAD}" />

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                        <CheckBox
                            IsChecked="{Binding FL.Config.Subs.WordLastSearchOnSelected}"
                            Content="{loc:Text Key=Text_04549E7105813E6C}" />
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Key=Text_3C09FE5BA47C0865}" Margin="10 0 10 0" />

                        <ComboBox
                            ItemsSource="{Binding ModifierKeys}"
                            SelectedItem="{Binding FL.Config.Subs.WordLastSearchOnSelectedModifier}"
                            Width="80">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConv}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text Key=Text_5D1BA7EB07E9873A}" Margin="0 0 10 0" />

                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding WordClickActions}"
                            SelectedItem="{Binding FL.Config.Subs.WordClickActionMethod, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_E45475F059D7326D}">
                <GroupBox.Resources>
                    <DataTemplate x:Key="SearchTemplate" DataType="{x:Type services:SearchMenuAction}">
                        <TextBox Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Left" />
                    </DataTemplate>

                    <DataTemplate x:Key="ClipboardTemplate" DataType="{x:Type services:ClipboardMenuAction}">
                        <CheckBox IsChecked="{Binding ToLower, UpdateSourceTrigger=PropertyChanged}" Content="{loc:Text Key=Text_C64ACC48C7D802C9}" />
                    </DataTemplate>

                    <DataTemplate x:Key="ClipboardAllTemplate" DataType="{x:Type services:ClipboardAllMenuAction}">
                        <CheckBox IsChecked="{Binding ToLower, UpdateSourceTrigger=PropertyChanged}" Content="{loc:Text Key=Text_C64ACC48C7D802C9}" />
                    </DataTemplate>

                    <local:MenuActionTemplateSelector
                        x:Key="MenuActionTemplateSelector"
                        SearchTemplate="{StaticResource SearchTemplate}"
                        ClipboardTemplate="{StaticResource ClipboardTemplate}"
                        ClipboardAllTemplate="{StaticResource ClipboardAllTemplate}" />

                    <Style x:Key="CenterVerticalTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="CenterVerticalTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </GroupBox.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid
                        x:Name="MenuActionsDataGrid"
                        Grid.Row="0"
                        ItemsSource="{Binding MenuActions}"
                        VerticalContentAlignment="Center"
                        ScrollViewer.CanContentScroll="False"
                        VerticalScrollBarVisibility="Disabled"
                        CanUserSortColumns="False"
                        SelectionMode="Single"
                        AutoGenerateColumns="False">

                        <!-- Set Behavior to enable line swapping by dragging -->
                        <i:Interaction.Behaviors>
                            <local:DataGridRowOrderBehaviorMenuAction
                            ItemsSource="{Binding MenuActions}"
                            DragTargetName="DragHandleBorder" />

                            <!-- Disable scroll event -->
                            <helpers:ScrollParentWhenAtMax />
                        </i:Interaction.Behaviors>

                        <DataGrid.Columns>
                            <!-- Order Column -->
                            <DataGridTemplateColumn Header="{loc:Text Key=Text_6BE090825C997103}" Width="70" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="DragHandleBorder"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Cursor="Hand"
                                            Background="#01000000">

                                            <materialDesign:PackIcon
                                                Kind="Menu"
                                                Width="24"
                                                Height="24"
                                                IsHitTestVisible="False"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Enabled Column -->
                            <DataGridCheckBoxColumn Header="{loc:Text Key=Text_92C1CDFDF4CB9CF6}" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" />

                            <!-- Type Column -->
                            <DataGridTextColumn
                                Header="{loc:Text Key=Text_BAADDF70FB5D432B}"
                                Binding="{Binding Type, Converter={StaticResource LocalizedTextConv}}"
                                ElementStyle="{StaticResource CenterVerticalTextBlockStyle}"
                                IsReadOnly="True"
                                Width="80" />

                            <!-- Title Column -->
                            <DataGridTemplateColumn
                                Header="{loc:Text Key=Text_7E8CD2056DA73A7F}"
                                Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title, Converter={StaticResource LocalizedTextConv}}" Style="{StaticResource CenterVerticalTextBlockStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CenterVerticalTextBoxStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Detail Column -->
                            <!-- Use TemplateSelector to change display items according to Action -->
                            <DataGridTemplateColumn
                                Width="*"
                                CellTemplateSelector="{StaticResource MenuActionTemplateSelector}">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel
                                        Background="#01000000"
                                        Cursor="Help"
                                        Orientation="Horizontal">
                                        <StackPanel.ToolTip>
                                            <ToolTip xml:space="preserve"><Run Text="{loc:Text Key=Text_0F49691292E19BBC}" /></ToolTip>
                                        </StackPanel.ToolTip>
                                        <TextBlock Text="{loc:Text Key=Text_45989DE49FB7F66D}" Margin="0 0 5 0" />
                                        <materialDesign:PackIcon
                                            VerticalAlignment="Center"
                                            Kind="TooltipHelp"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                            </DataGridTemplateColumn>

                            <!-- Delete Column -->
                            <DataGridTemplateColumn Header="{loc:Text Key=Text_E2D0A54968EAD24E}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Button
                                            ToolTip="{loc:Text Key=Text_E2D0A54968EAD24E}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            HorizontalAlignment="Center"
                                            Width="30"
                                            Height="30"
                                            Command="{Binding DataContext.CmdRemoveAction, ElementName=MenuActionsDataGrid}"
                                            CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button
                                Content="{loc:Text Key=Text_F020B15CCD6E7EB5}"
                                Command="{Binding CmdAddSearchAction}"
                                Margin="0 0 8 0" />
                            <Button
                                Content="{loc:Text Key=Text_7CEBB5581379DC03}"
                                Command="{Binding CmdAddClipboardAction}"
                                Margin="0 0 8 0" />
                            <Button
                                Content="{loc:Text Key=Text_7B7D45224342142B}"
                                Command="{Binding CmdAddClipboardAllAction}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Content="{loc:Text Key=Text_31E392D1C0378BEC}"
                                Command="{Binding CmdApplyContextMenu}"
                                Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                                Margin="0 0 8 0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_C74E8E2C4CE6FBE8}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_6563232712CAE6F1}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{loc:Text Key=Text_26F7FE1AC74546ED}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <ToggleButton
                            IsChecked="{Binding FL.Config.Subs.SubsAutoTextCopy}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_13558313E4CB2AB3}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource SubAutoTextCopyTargetEnum}}"
                            SelectedItem="{Binding FL.Config.Subs.SubsAutoTextCopyTarget}" />
                    </StackPanel>

                    <TextBlock Margin="5 10 5 0">
                        <Run Text="{loc:Text Key=Text_C53AEDAF558DC711}" /> <Hyperlink Style="{StaticResource MyHyperLink}" NavigateUri="https://github.com/umlx5h/LLPlayer/wiki/Browser-Extensions-Integration" helpers:HyperlinkHelper.OpenInBrowser="True"><Run Text="{loc:Text Key=Text_38600672B6ED5372}" /></Hyperlink>
                        <Run Text="{loc:Text Key=Text_0895E3EA3D207F41}" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_1ECF8F59518E6326}" Visibility="{Binding IsTargetJapanese, Converter={StaticResource BooleanToVisibilityConv}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock
                            Text="{loc:Text Key=Text_CB3F42C5D0C67CF4}"
                            Width="180" />
                        <TextBox
                            HorizontalContentAlignment="Left"
                            Text="{Binding FL.Config.Subs.PDICPipeExecutablePath}" />
                    </DockPanel>

                    <Button
                        Content="{loc:Text Key=Text_FFE5A4C67213462F}"
                        HorizontalAlignment="Left"
                        Command="{Binding CmdSetPdicPath}"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                        Margin="180 0 0 0" />

                    <TextBlock Margin="5 10 5 0">
                        <Run Text="{loc:Text Key=Text_4CEC3B785EC9FBAC}" />
                        <LineBreak />
                        <Run Text="{loc:Text Key=Text_D268F543C37580A9}" /> <Hyperlink Style="{StaticResource MyHyperLink}" NavigateUri="https://github.com/umlx5h/LLPlayer/wiki/PDIC-Integration-(For-Japanese-users)" helpers:HyperlinkHelper.OpenInBrowser="True"><Run Text="{loc:Text Key=Text_38600672B6ED5372}" /></Hyperlink>
                        <Run Text="{loc:Text Key=Text_0895E3EA3D207F41}" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
