<UserControl x:Class="LLPlayer.Controls.Settings.SettingsSubtitlesOCR"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:flyleaf="clr-namespace:FlyleafLib;assembly=FlyleafLib"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SettingsSubtitlesOCRVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="SubOCREngineTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="flyleaf:SubOCREngineType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_FF81CAD43A374194}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_C78887D664E6D067}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_91AF5B3EAE9610FD}" />
                        <ComboBox
                            Width="120"
                            ItemsSource="{Binding Source={StaticResource SubOCREngineTypeEnum}}"
                            SelectedItem="{Binding FL.PlayerConfig.Subtitles[0].OCREngine}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_C63F46A4B8DEB5D6}" />
                        <ComboBox
                            Width="120"
                            ItemsSource="{Binding Source={StaticResource SubOCREngineTypeEnum}}"
                            SelectedItem="{Binding FL.PlayerConfig.Subtitles[1].OCREngine}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Tesseract OCR">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Grid.Row="0"
                        FontSize="14" FontWeight="Bold"
                        Text="{loc:Text Key=Text_A9088C174040CBD8}" />

                    <TextBlock
                        Grid.Column="1"
                        Grid.Row="0"
                        FontSize="14" FontWeight="Bold"
                        Text="{loc:Text Key=Text_BC8BF047C15F9EC8}" />

                    <ListView
                        Grid.Column="0"
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding DownloadedTessLanguages}"
                        MaxHeight="300"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Header="{loc:Text Key=Text_A4FE65264EF7DBB3}"
                                    DisplayMemberBinding="{Binding Lang}"
                                    Width="200" />

                                <GridViewColumn
                                    Header="{loc:Text Key=Text_1AF851907331C0ED}"
                                    DisplayMemberBinding="{Binding Size, Converter={StaticResource FileSizeHumanConv}}"
                                    Width="120" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ListView
                        Grid.Row="1"
                        Grid.Column="1"
                        MaxHeight="300"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ItemsSource="{Binding TessLanguageGroups}" Margin="10">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="{Binding DisplayName}"
                                        Width="100"
                                        VerticalAlignment="Center" />
                                    <ComboBox
                                        ItemsSource="{Binding Members}"
                                        SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                        DisplayMemberPath="DisplayName"
                                        Width="150"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        Grid.Column="0"
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Margin="0 15 0 0"
                        MaxWidth="150"
                        Content="{loc:Text Key=Text_26AE614BDD1CAE44}"
                        Command="{Binding CmdDownloadTessModel}" />

                    <TextBlock Grid.Column="1" Grid.Row="2" Margin="5 10 5 0">
                        <Run Text="{loc:Text Key=Text_B24F8E9268EA91BD}" />
                    </TextBlock>
                </Grid>
            </GroupBox>

            <GroupBox Header="Microsoft OCR">
                <Grid Margin="10 10 30 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0" Grid.Column="0"
                        FontSize="14" FontWeight="Bold"
                        Text="{loc:Text Key=Text_CFAFB772084ED0DF}" />

                    <TextBlock
                        Grid.Row="0" Grid.Column="1"
                        FontSize="14" FontWeight="Bold"
                        Text="{loc:Text Key=Text_BC8BF047C15F9EC8}" />

                    <ListView
                        Grid.Row="1"
                        Grid.Column="0"
                        MaxHeight="300"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ItemsSource="{Binding AvailableMsOcrLanguages}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Header="{loc:Text Key=Text_A4FE65264EF7DBB3}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    Width="150" />

                                <GridViewColumn
                                    Header="{loc:Text Key=Text_340F463033E0FD5D}"
                                    DisplayMemberBinding="{Binding LanguageTag}"
                                    Width="150"  />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ListView
                        Grid.Row="1"
                        Grid.Column="1"
                        MaxHeight="300"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ItemsSource="{Binding MsLanguageGroups}" Margin="10">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Width="100" VerticalAlignment="Center"/>
                                    <ComboBox
                                        ItemsSource="{Binding Members}"
                                        SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                        DisplayMemberPath="DisplayName"
                                        Width="150"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Column="0" Grid.Row="2" Margin="5 10 5 0">
                        <Run Text="{loc:Text Key=Text_D46F546156882046}" />
                        <Hyperlink Style="{StaticResource MyHyperLink}" NavigateUri="https://learn.microsoft.com/en-us/windows/powertoys/text-extractor#supported-languages" helpers:HyperlinkHelper.OpenInBrowser="True">
                            <Run Text="{loc:Text Key=Text_38600672B6ED5372}" />
                        </Hyperlink>
                        <Run Text="{loc:Text Key=Text_60DC114DB3EE887C}" />
                    </TextBlock>

                    <TextBlock Grid.Column="1" Grid.Row="2" Margin="5 10 5 0">
                        <Run Text="{loc:Text Key=Text_0466A4D3FA5ACF4E}" />
                    </TextBlock>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
