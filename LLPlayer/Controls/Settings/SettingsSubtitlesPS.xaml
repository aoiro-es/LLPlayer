<UserControl x:Class="LLPlayer.Controls.Settings.SettingsSubtitlesPS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:services="clr-namespace:LLPlayer.Services"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="TrackPlacementEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="services:SubtitleTrackPlacement" /></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="SubPositionAlignmentEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="services:SubPositionAlignment"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_A637D33169589C62}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_91F6A26DF1C210E7}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="180" Text="{loc:Text Key=Text_2186B78270DF5F26}" />
                        <ComboBox Width="200" ItemsSource="{Binding Source={StaticResource TrackPlacementEnum}}" SelectedItem="{Binding FL.Config.Subs.PrimaryPlacement}" />
                    </StackPanel>
                    <CheckBox Content="{loc:Text Key=Text_7D0D39D49E593B94}" IsChecked="{Binding FL.Config.Subs.PrimaryOnlyOnEdgeHover}" Margin="0 8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="180" Text="{loc:Text Key=Text_BFC2574C93A17224}" />
                        <ComboBox Width="200" ItemsSource="{Binding Source={StaticResource TrackPlacementEnum}}" SelectedItem="{Binding FL.Config.Subs.SecondaryPlacement}" />
                    </StackPanel>
                    <CheckBox Content="{loc:Text Key=Text_6CD16D9CDC6CAD68}" IsChecked="{Binding FL.Config.Subs.SecondaryOnlyOnEdgeHover}" Margin="0 8" />
                    <TextBlock Text="{loc:Text Key=Text_46DDA7AFF7D8C722}" TextWrapping="Wrap" Margin="0 0 0 8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="180" Text="{loc:Text Key=Text_32CCE21DEBA21D03}" />
                        <TextBox Width="100" Text="{Binding FL.Config.Subs.EdgeMargin}" helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="180" Text="{loc:Text Key=Text_8CA11C821DF59344}" />
                        <TextBox Width="100" Text="{Binding FL.Config.Subs.HoverRegionHeight}" helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="{loc:Text Key=Text_54DFF361FCD147DF}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_732D418A32BE3E0F}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsWidthPercentage}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_D142C2FFCA35005A}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{loc:Text Key=Text_8124ACE4EAEC358A}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsMaxWidth}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_A83E9982006CC0EC}" />
                        <ToggleButton
                            IsChecked="{Binding FL.Config.Subs.SubsIgnoreLineBreak}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_5AC5CF5D1F24F95C}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsPosition}"
                            helpers:TextBoxHelper.OnlyNumeric="Int"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_61859FCBC87E0812}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsDistance}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_C9317A6CBF60A9EA}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsSeparatorMaxWidth}"
                            helpers:TextBoxHelper.OnlyNumeric="Double"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180">
                            <Run Text="{loc:Text Key=Text_3EA9DC41B9D6E372}" />
                            <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{loc:Text Key=Text_D2F65F881E4322C3}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <Slider
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding FL.Config.Subs.SubsSeparatorOpacity,
                                Converter={StaticResource DoubleToPercentageConv}}"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignDiscreteSlider}"
                            materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                            TickFrequency="1"
                            Width="160" />
                        <TextBox
                            Width="30"
                            Margin="4 0 0 0"
                            Text="{Binding FL.Config.Subs.SubsSeparatorOpacity,
                                 Converter={StaticResource DoubleToPercentageConv}, UpdateSourceTrigger=PropertyChanged}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                        <TextBlock Text="%" Margin="2 0 0 0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_CFE3010F90B77D0B}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Config.Subs.SubsFixOverflowMargin}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_0F82C835D0E5D0B0}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource SubPositionAlignmentEnum}}"
                            SelectedItem="{Binding FL.Config.Subs.SubsPositionAlignment}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_9779E63B0E5A765A}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource SubPositionAlignmentEnum}}"
                            SelectedItem="{Binding FL.Config.Subs.SubsPositionAlignmentWhenDual}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_06D5F40ED59448A0}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Player.Subtitles[0].Data.BitmapPosition.ConfScale, StringFormat={}{0:F2}}"
                            helpers:TextBoxHelper.OnlyNumeric="Double"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_CC81CCFE6D387CCA}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Player.Subtitles[1].Data.BitmapPosition.ConfScale, StringFormat={}{0:F2}}"
                            helpers:TextBoxHelper.OnlyNumeric="Double"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_EC9E18A347A5EE5C}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.Player.Subtitles[0].Data.BitmapPosition.ConfPos}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
