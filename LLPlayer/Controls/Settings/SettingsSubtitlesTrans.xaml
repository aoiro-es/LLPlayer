                    <TextBlock Text="{Binding FL.Player.SubtitlesManager[1].TranslationError}" TextWrapping="Wrap" Margin="24 0 0 4" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
                    <TextBlock Text="{loc:Text Key=Text_01EA1E188869EF4C}" TextWrapping="Wrap" Margin="0 8 0 0" />
