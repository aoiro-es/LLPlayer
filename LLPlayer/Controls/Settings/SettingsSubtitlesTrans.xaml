                            Width="180"
                            Text="{Binding FL.PlayerConfig.Subtitles.TranslateTargetLanguage, Converter={StaticResource TargetLanguageEnumToNoSupportedTranslateServiceConv}}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_1CA478B19DC534F6}">
