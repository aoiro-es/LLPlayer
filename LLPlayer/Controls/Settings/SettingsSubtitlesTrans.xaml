                                    <TextBlock
                                        Text="{loc:Text Key=Text_88917B4BBFB7F03A}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400" />
                                </ToolTipService.ToolTip>
                                <materialDesign:PackIcon
                                    Kind="Information"
                                    Width="16" Height="16"
                                    Margin="4 0 0 0" />
                            </InlineUIContainer>
                        </TextBlock>
                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding Source={StaticResource TranslateTargetLanguageEnum}}"
                            SelectedItem="{Binding FL.PlayerConfig.Subtitles.TranslateTargetLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TargetLanguageEnumToStringConv}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_904F02982FDE45FE}" />

