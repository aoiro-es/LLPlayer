                            Width="180">
                            <Hyperlink Style="{StaticResource MyHyperLink}" NavigateUri="{Binding SelectedTranslateServiceType, Converter={StaticResource TranslateServiceTypeEnumToUrlConv}}" helpers:HyperlinkHelper.OpenInBrowser="True">
                                <Run Text="{loc:Text Key=Text_1CA478B19DC534F6}" />
                            </Hyperlink>
                        </TextBlock>
                        <ComboBox
                            Width="320"
                            ItemsSource="{Binding Source={StaticResource TranslateServiceTypeEnum}}"
                            SelectedItem="{Binding SelectedTranslateServiceType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TranslateServiceTypeEnumToStringConv}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <ContentControl Content="{Binding SelectedServiceSettings}" />
                </StackPanel>
            </GroupBox>

