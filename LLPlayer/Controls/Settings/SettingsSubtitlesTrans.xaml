    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_FBBB407099759180}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_A1265FB0E4FEF2E7}">
                <StackPanel>
                    <CheckBox Content="{loc:Text Key=Text_C87139466A105E8F}" IsChecked="{Binding FL.PlayerConfig.Subtitles[0].EnabledTranslated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 4" />
                    <TextBlock Text="{Binding FL.Player.SubtitlesManager[0].TranslationStatus}" TextWrapping="Wrap" Margin="24 2 0 2" />
                    <TextBlock Text="{Binding FL.Player.SubtitlesManager[0].TranslationError}" TextWrapping="Wrap" Margin="24 0 0 4" Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
