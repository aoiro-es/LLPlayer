<UserControl x:Class="LLPlayer.Controls.Settings.SettingsVideo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:flyleaf="clr-namespace:FlyleafLib;assembly=FlyleafLib"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="VideoProcessorEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="flyleaf:VideoProcessors"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="DeInterlaceEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="flyleaf:DeInterlace"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="HDRtoSDRMethodEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="flyleaf:HDRtoSDRMethod"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel>
            <TextBlock
                Text="{loc:Text Key=Text_D534BE829E32196B}"
                FontSize="24"
                FontWeight="Bold"
                Margin="0 0 0 16" />

            <GroupBox Header="{loc:Text Key=Text_D534BE829E32196B}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_556F85EFA2BEEC52}" />

                        <ComboBox
                            x:Name="cmbAspectRatio"
                            Width="100"
                            ItemsSource="{x:Static flyleaf:AspectRatio.AspectRatios}"
                            SelectedItem="{Binding FL.Player.Config.Video.AspectRatio}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedTextConv}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox
                            Width="60"
                            HorizontalContentAlignment="Right"
                            VerticalContentAlignment="Center"
                            Margin="10 0 0 0"
                            PreviewTextInput="ValidationRatio"
                            Text="{Binding FL.PlayerConfig.Video.AspectRatioCustom, Converter={StaticResource StringToRationalConv}}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=cmbAspectRatio, Path=SelectedItem}" Value="{x:Static flyleaf:AspectRatio.Custom}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_E551B1F1B22A75D5}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource DeInterlaceEnum}}"
                            SelectedItem="{Binding FL.PlayerConfig.Video.DeInterlace}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_EDF6549669CF1F30}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Video.DoubleRate}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_706D3555857D1C9A}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Video.SuperResolution}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_4A4A0AF7C6A0C245}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Decoder.AllowProfileMismatch}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_B16A5A0D774208C8}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Video.VSync}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_D73A4EE5445D959B}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Video.VideoAcceleration}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_2DCB215D5412B45F}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource VideoProcessorEnum}}"
                            SelectedItem="{Binding FL.PlayerConfig.Video.VideoProcessor}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_987F13F257E1C91E}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Decoder.VideoThreads}"
                            helpers:TextBoxHelper.OnlyNumeric="Uint" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_9C0319D76C288E6A}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Video.ZoomOffset}"
                            helpers:TextBoxHelper.OnlyNumeric="Int" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_531B60E17C071406}" />
                        <TextBox
                            Width="100"
                            Text="{Binding FL.PlayerConfig.Player.MaxLatency, Converter={StaticResource TicksToMilliSecondsConv}}"
                            helpers:TextBoxHelper.OnlyNumeric="Int" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_27F0618FA5D5D78B}" />
                        <ToggleButton
                            IsChecked="{Binding FL.PlayerConfig.Player.ZeroLatency}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_BB34B2761D15BB4C}" />
                        <ComboBox
                            Width="100"
                            ItemsSource="{Binding Source={StaticResource HDRtoSDRMethodEnum}}"
                            SelectedItem="{Binding FL.PlayerConfig.Video.HDRtoSDRMethod}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="180"
                            Text="{loc:Text Key=Text_9BA354DA5D013722}" />
                        <Slider
                            Width="200"
                            Value="{Binding FL.PlayerConfig.Video.SDRDisplayNits}"
                            Minimum="25"
                            Maximum="400"
                            Style="{StaticResource MaterialDesignDiscreteSlider}"
                            materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" />
                        <TextBox
                            Width="30"
                            Margin="4 0 0 0"
                            Text="{Binding FL.PlayerConfig.Video.SDRDisplayNits}"
                            helpers:TextBoxHelper.OnlyNumeric="Int" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{loc:Text Key=Text_546EBB8EB993EA56}">
                <StackPanel>
                    <ItemsControl>
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemsSource" Value="{Binding FL.PlayerConfig.Video.FLFilters.Values}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FL.PlayerConfig.Video.VideoProcessor}" Value="{x:Static flyleaf:VideoProcessors.D3D11}">
                                        <Setter Property="ItemsSource" Value="{Binding FL.PlayerConfig.Video.D3Filters.Values}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FL.Player.Renderer.VideoProcessor}" Value="{x:Static flyleaf:VideoProcessors.D3D11}">
                                        <Setter Property="ItemsSource" Value="{Binding FL.PlayerConfig.Video.D3Filters.Values}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="0 0 0 8"
                                    Visibility="{Binding Available, Converter={StaticResource BooleanToVisibilityConv}}">
                                    <TextBlock
                                        Width="180"
                                        Text="{Binding Filter}" />
                                    <Slider
                                        Width="200"
                                        Value="{Binding Value}"
                                        Minimum="{Binding Minimum}"
                                        Maximum="{Binding Maximum}"
                                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                                        materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                                        VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True" />
                                    <TextBox
                                        Width="30"
                                        Margin="4 0 0 0"
                                        Text="{Binding Value}"
                                        helpers:TextBoxHelper.OnlyNumeric="Int" />
                                    <Button
                                        Margin="6 0 0 0"
                                        ToolTip="{loc:Text Key=Text_BC5B45AE7B60692A}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        HorizontalAlignment="Center"
                                        Width="24"
                                        Height="24"
                                        Command="{Binding SetDefaultValue}">
                                        <materialDesign:PackIcon Kind="BackupRestore" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button
                        Margin="360 6 0 0"
                        HorizontalAlignment="Left"
                        Content="{loc:Text Key=Text_645982C52B7C11AE}"
                        Command="{Binding FL.Player.Commands.ResetFilters}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
