<UserControl x:Class="LLPlayer.Controls.Settings.TransControl.CodexTranslateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions">
    <StackPanel x:Name="SettingsPanel">
        <TextBlock Text="{loc:Text Key=Text_60BC06472326CEB1}" TextWrapping="Wrap" Margin="0 0 0 12" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Width="180" Text="{loc:Text Key=Text_FAE0C1FCE7118192}" />
            <TextBox Width="320" Text="{Binding Settings.ExecutablePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}" />
            <Button Margin="10 0" Content="{loc:Text Key=Text_3227AA9666253F7A}" Command="{Binding CmdBrowse}" />
        </StackPanel>
        <TextBlock Text="{loc:Text Key=Text_A342F3001C62EBDB}" TextWrapping="Wrap" Margin="0 6 0 12" />
        <WrapPanel>
            <Button Content="{loc:Text Key=Text_F6DE648021FDA93B}" Command="{Binding CmdSignIn}" Margin="0 0 10 6" />
            <Button Content="{loc:Text Key=Text_98D2E8192124AA78}" Command="{Binding CmdRefresh}" Margin="0 0 10 6" />
            <Button Content="{loc:Text Key=Text_19766ED6CCB2F4A3}" Command="{Binding CmdCancel}" IsEnabled="{Binding IsBusy}" Margin="0 0 0 6" />
        </WrapPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0 4 0 14" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Width="180" Text="{loc:Text Key=Text_5E2C614C23F02239}" />
            <ComboBox Width="320" ItemsSource="{Binding Models}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding CanInteract}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0 8">
            <TextBlock Width="180" Text="{loc:Text Key=Text_3236AEEC43E563CA}" />
            <ComboBox Width="220" ItemsSource="{Binding Efforts}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Settings.ReasoningEffort}" IsEnabled="{Binding CanInteract}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Width="180" Text="{loc:Text Key=Text_3B453BC8BD286BE4}" />
            <TextBox Width="100" Text="{Binding Settings.TimeoutMs}" helpers:TextBoxHelper.OnlyNumeric="Uint" />
        </StackPanel>
        <TextBlock Text="{loc:Text Key=Text_10D3AFCACD008FC9}" TextWrapping="Wrap" Margin="0 12" />
        <StackPanel Orientation="Horizontal"><TextBlock Width="180" Text="{loc:Text Key=Text_2B7C02D674D13D84}"/><TextBox Width="100" Text="{Binding Settings.BatchSize}" helpers:TextBoxHelper.OnlyNumeric="Uint"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0 8"><TextBlock Width="180" Text="{loc:Text Key=Text_DC0DFE8999607203}"/><TextBox Width="100" Text="{Binding Settings.ContextCues}" helpers:TextBoxHelper.OnlyNumeric="Uint"/></StackPanel>
        <CheckBox Content="{loc:Text Key=Text_1228CCB005415C82}" IsChecked="{Binding Settings.PreGenerateExplanations}" Margin="0 8"/>
        <TextBlock Text="{loc:Text Key=Text_029D680D7F7CFF2A}" TextWrapping="Wrap"/>
        <TextBlock Text="{loc:Text Key=Text_98C06F3B0AB36EFD}" TextWrapping="Wrap" Margin="0 10 0 0" />
    </StackPanel>
</UserControl>
