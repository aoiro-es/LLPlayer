<UserControl x:Class="LLPlayer.Controls.Settings.TransControl.OpenAIBaseTranslateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LLPlayer.Controls.Settings.TransControl"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             xmlns:services="clr-namespace:FlyleafLib.MediaPlayer.Translation.Services;assembly=FlyleafLib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DataContext="{d:DesignInstance services:OpenAIBaseTranslateSettings}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock
                Width="180"
                Text="{loc:Text Key=Text_3DF9726C68BA76D6}" />
            <TextBox
                HorizontalContentAlignment="Left"
                Width="300"
                Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="10 0 0 0"
                Content="{loc:Text Key=Text_DAEE7606B339F3C3}"
                Command="{Binding CmdSetDefaultEndpoint}"
                Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button
                Command="{Binding CmdCheckEndpoint}"
                Content="{loc:Text Key=Text_9D60841E0A7891DF}"
                Margin="10 0 0 0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock
                Width="180"
                Text="{loc:Text Key=Text_3B453BC8BD286BE4}" />
            <TextBox
                Width="100"
                Text="{Binding TimeoutMs}"
                helpers:TextBoxHelper.OnlyNumeric="Uint" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock
                Width="180"
                Text="{loc:Text Key=Text_10B83BBC0D347F2B}" />
            <TextBox
                Width="100"
                Text="{Binding TimeoutHealthMs}"
                helpers:TextBoxHelper.OnlyNumeric="Uint" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock
                FontSize="14"
                Width="180">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
                        <Setter Property="Text" Value="{loc:Text Key=Text_5E2C614C23F02239}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModelRequired}" Value="False">
                                <Setter Property="Text" Value="{loc:Text Key=Text_CAA6106F12068E1E}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ComboBox
                Width="260"
                ItemsSource="{Binding AvailableModels}"
                IsEditable="True"
                Text="{Binding Model, Mode=TwoWay}">
            </ComboBox>
            <Button
                Command="{Binding CmdGetModels}"
                Content="{loc:Text Key=Text_5A035C35073FB5F1}"
                Margin="10 0 0 0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock
                Width="180"
                Text="{loc:Text Key=Text_1A03BD2FD107C453}" />
            <Button
                Command="{Binding CmdHelloModel}"
                Content="{loc:Text Key=Text_2A1380458583FABD}"
                Margin="10 0 0 0" />
        </StackPanel>

        <DockPanel Margin="0 0 0 8" Visibility="{Binding StatusAvailable, Converter={StaticResource BooleanToVisibilityConv}}">
            <TextBlock
                Width="180"
                Text="{loc:Text Key=Text_D18CD0DC6494ECE7}" />
            <TextBox
                HorizontalContentAlignment="Left"
                TextWrapping="Wrap"
                IsReadOnly="True"
                Text="{Binding Status, Mode=OneWay}" />
        </DockPanel>

        <Expander Header="{loc:Text Key=Text_7476E29F38024D55}">
            <StackPanel Margin="10">
                <TextBlock
                    FontWeight="Medium"
                    Margin="8 0 0 8"
                    HorizontalAlignment="Left"
                    Width="180">
                    <Hyperlink Style="{StaticResource MyHyperLink}" NavigateUri="https://platform.openai.com/docs/api-reference/chat/create" helpers:HyperlinkHelper.OpenInBrowser="True">
                        <Run Text="{loc:Text Key=Text_CA44E59B13B5E73A}" />
                    </Hyperlink>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 12"
                            VerticalAlignment="Center">
                    <TextBlock
                        Width="180">
                        temperature
                        <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                            <ToolTipService.ToolTip>
                                <TextBlock
                                    Text="{loc:Text Key=Text_9827F64884858FCA}"
                                    TextWrapping="Wrap"
                                    MaxWidth="400" />
                            </ToolTipService.ToolTip>
                            <materialDesign:PackIcon
                                Kind="Information"
                                Width="16" Height="16"
                                Margin="4 0 0 0" />
                        </InlineUIContainer>
                    </TextBlock>

                    <CheckBox
                        Content="{loc:Text Key=Text_B0B9FE24FFA96291}"
                        IsChecked="{Binding TemperatureManual}" />
                    <Slider
                        Minimum="0" Maximum="2" TickFrequency="0.01" IsSnapToTickEnabled="True"
                        Margin="8 0 0 0"
                        Value="{Binding Temperature}"
                        Width="200"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                        materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                        IsEnabled="{Binding TemperatureManual}" />
                    <TextBox
                        Width="40"
                        Text="{Binding Temperature}"
                        IsEnabled="{Binding TemperatureManual}"
                        helpers:TextBoxHelper.OnlyNumeric="Double" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 12"
                            VerticalAlignment="Center">
                    <TextBlock
                        Width="180">
                        top_p
                        <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                            <ToolTipService.ToolTip>
                                <TextBlock
                                    Text="{loc:Text Key=Text_B55E12D9089986F7}"
                                    TextWrapping="Wrap"
                                    MaxWidth="400" />
                            </ToolTipService.ToolTip>
                            <materialDesign:PackIcon
                                Kind="Information"
                                Width="16" Height="16"
                                Margin="4 0 0 0" />
                        </InlineUIContainer>
                    </TextBlock>
                    <CheckBox
                        Content="{loc:Text Key=Text_B0B9FE24FFA96291}"
                        IsChecked="{Binding TopPManual}" />
                    <Slider
                        Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                        Margin="8 0 0 0"
                        Value="{Binding TopP}"
                        Width="200"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                        materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                        IsEnabled="{Binding TopPManual}" />
                    <TextBox
                        Width="40"
                        Text="{Binding TopP}"
                        IsEnabled="{Binding TopPManual}"
                        helpers:TextBoxHelper.OnlyNumeric="Double" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                    <TextBlock
                        Width="180">
                        max_tokens
                        <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                            <ToolTipService.ToolTip>
                                <TextBlock
                                    Text="{loc:Text Key=Text_360D3D82D8C9B3F9}"
                                    TextWrapping="Wrap"
                                    MaxWidth="400" />
                            </ToolTipService.ToolTip>
                            <materialDesign:PackIcon
                                Kind="Information"
                                Width="16" Height="16"
                                Margin="4 0 0 0" />
                        </InlineUIContainer>
                    </TextBlock>
                    <TextBox
                        Width="100"
                        Text="{Binding MaxTokens, Converter={StaticResource NullableIntConv}}"
                        helpers:TextBoxHelper.OnlyNumeric="Uint" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                    <TextBlock
                        Width="180">
                        max_completion_tokens
                        <InlineUIContainer BaselineAlignment="Center" Cursor="Help">
                            <ToolTipService.ToolTip>
                                <TextBlock
                                    Text="{loc:Text Key=Text_5A72737EAEBAFFE8}"
                                    TextWrapping="Wrap"
                                    MaxWidth="400" />
                            </ToolTipService.ToolTip>
                            <materialDesign:PackIcon
                                Kind="Information"
                                Width="16" Height="16"
                                Margin="4 0 0 0" />
                        </InlineUIContainer>
                    </TextBlock>
                    <TextBox
                        Width="100"
                        Text="{Binding MaxCompletionTokens, Converter={StaticResource NullableIntConv}}"
                        helpers:TextBoxHelper.OnlyNumeric="Uint" />
                </StackPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
