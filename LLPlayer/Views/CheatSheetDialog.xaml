                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_B5BA46CC38166950}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_7C47BDD0D4CE99D1}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Padding="15"
                            Header="{loc:Text Key=Text_97063075BAA70105}"
                            Margin="20 10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_352649FDCB1F6C54}"
                                        Width="200" />
