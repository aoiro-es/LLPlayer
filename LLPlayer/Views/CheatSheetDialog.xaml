                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Padding="15"
                            Header="{loc:Text Key=Text_C694EFCAF9BE6DEB}"
                            Margin="20 10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_352649FDCB1F6C54}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_4089AD397656703E}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_AED36B23066D40EF}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_6A669591B269F84D}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_BFD96C3F901F1179}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_6A669591B269F84D}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Padding="15"
                            Header="{loc:Text Key=Text_8BD0E88C36675E7D}"
                            Margin="20 10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_352649FDCB1F6C54}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_1AF7BE82593980F1}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
