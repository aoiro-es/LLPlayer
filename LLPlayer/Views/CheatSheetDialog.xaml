                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_81AB196FB5703CE0}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </materialDesign:Card>
</UserControl>
