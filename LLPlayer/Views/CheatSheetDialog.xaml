<UserControl x:Class="LLPlayer.Views.CheatSheetDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:LLPlayer.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialDesignInternal="clr-namespace:MaterialDesignThemes.Wpf.Internal;assembly=MaterialDesignThemes.Wpf"
             xmlns:helpers="clr-namespace:LLPlayer.Extensions"
             Loaded="OnLoaded"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CheatSheetDialogVM}"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConv" />
        <DataTemplate x:Key="ActionGroupItemTemplate" DataType="{x:Type vm:KeyBindingCSGroup}">
            <GroupBox
                materialDesign:ColorZoneAssist.Background="{Binding GroupColor, Converter={StaticResource ColorToBrushConv}}"
                materialDesign:ColorZoneAssist.Foreground="{DynamicResource MaterialDesignBody}"
                materialDesign:ColorZoneAssist.Mode="Custom"
                Header="{Binding GroupName}"
                Margin="10"
                Visibility="{Binding ElementName=ActionListView, Path=Items.Count, Converter={StaticResource CountToVisibilityConv}}">
                <ListView
                    x:Name="ActionListView"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Focusable="False"
                    IsTabStop="False"
                    ItemsSource="{Binding KeyBindings}">

                    <!-- Scroll events are received by ScrollViewer instead of ListView -->
                    <i:Interaction.Behaviors>
                        <helpers:ScrollParentWhenAtMax />
                    </i:Interaction.Behaviors>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:KeyBindingCS}">
                                        <Button
                                            ToolTip="{loc:Text Key=Text_DDE20D6699350501}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="20"
                                            Height="20"
                                            Command="{Binding DataContext.CmdAction, ElementName=ActionListsItemsControl}"
                                            CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Play" />
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Text Key=Text_5753EA3780F34AD1}" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:KeyBindingCS}">
                                        <TextBlock
                                            Text="{Binding Path=Shortcut}"
                                            FontSize="14"
                                            TextWrapping="Wrap"
                                            FontWeight="SemiBold" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Text Key=Text_64CFF1319D2FD2CB}" Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:KeyBindingCS}">
                                        <TextBlock
                                            Text="{Binding Path=Description}"
                                            TextWrapping="Wrap"
                                            ToolTip="{Binding ActionName}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>

                    <ListView.ItemContainerStyle>
                        <Style
                            TargetType="ListViewItem"
                            BasedOn="{StaticResource MaterialDesignGridViewItem}">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </GroupBox>
        </DataTemplate>

        <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignGroupBox}">
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <materialDesign:Card>
        <TabControl
            HorizontalContentAlignment="Center"
            materialDesign:ColorZoneAssist.Mode="PrimaryLight">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Keyboard" />
                        <TextBlock Text="{loc:Text Key=Text_2316810A5DE343DD}" Margin="6 0 0 0" />
                    </StackPanel>
                </TabItem.Header>
                <!--TODO: L: Aggregate display of multiple keys assigned to the same action? -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <StackPanel Orientation="Horizontal" Margin="50 10 0 10" Grid.Row="0">
                        <TextBox
                            x:Name="SearchBox"
                            materialDesign:HintAssist.FloatingScale="0.50"
                            materialDesign:HintAssist.Hint="{loc:Text Key=Text_D47630DDA5F8DAC9}"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.TextBoxViewMargin="1 0 1 0"
                            Width="300"
                            FontSize="16"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Escape"
                                    Command="{x:Static materialDesignInternal:ClearText.ClearCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding Path=HitCount, StringFormat={loc:Text Key=Text_266738255D78D27E}}"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Margin="10 0 0 0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Center">
                            <ItemsControl
                                x:Name="ActionListsItemsControl"
                                ItemsSource="{Binding KeyBindingGroups}"
                                ItemTemplate="{StaticResource ActionGroupItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel  />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem FontSize="16">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Mouse" />
                        <TextBlock Text="{loc:Text Key=Text_55C1520824A84D75}" Margin="6 0 0 0" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer>
                    <StackPanel>
                        <GroupBox
                            Padding="15"
                            Header="{loc:Text Key=Text_EE9193F8C5AF17FC}"
                            Margin="20 10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10"
                                            Visibility="{Binding FL.Config.MouseSingleClickToPlay, Converter={StaticResource BooleanToVisibilityConv}}">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_352649FDCB1F6C54}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_66EB090217B4DF32}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10"
                                            Visibility="{Binding FL.Config.MouseDoubleClickToFullScreen, Converter={StaticResource BooleanToVisibilityConv}}">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_5C990DA297C87A91}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_185CE7BC67EEF153}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_AED36B23066D40EF}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_B293FE310FE7166C}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
