                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_53F3EE69DD8FBD92}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_6DDF8E185E22F897}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_DB4D3CB4D84C3931}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_8B05751836E054DC}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_A877B54C52F8DA5A}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10"
                                            Visibility="{Binding FL.Config.MouseWheelToVolumeUpDown, Converter={StaticResource BooleanToVisibilityConv}}">
