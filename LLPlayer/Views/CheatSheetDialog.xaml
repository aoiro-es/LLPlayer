                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_51E1B843E0D0BED6}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
                                        Text="{loc:Text Key=Text_BF2C5996736A05B5}"
                                        Width="200" />
                                    <TextBlock
                                        Text="{loc:Text Key=Text_2E8185D92314AF81}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                    <TextBlock
