<UserControl x:Class="LLPlayer.Views.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:FlyleafLib.Localization;assembly=FlyleafLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:LLPlayer.Views"
             xmlns:settings="clr-namespace:LLPlayer.Controls.Settings"
             d:DataContext="{d:DesignInstance vm:SettingsDialogVM}"
             mc:Ignorable="d"
             d:Foreground="White"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <materialDesign:DialogHost
        DialogTheme="Inherit"
        Identifier="SettingsDialog_RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0 0 1 0">
                <TreeView
                    x:Name="SettingsTreeView"
                    FontWeight="Bold"
                    FontSize="16"
                    SelectedItemChanged="SettingsTreeView_OnSelectedItemChanged">
                    <TreeViewItem Tag="SettingsPlayer" IsSelected="True">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PlayCircle" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_64AEE8C6CBD026D9}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>

                    <TreeViewItem Tag="SettingsVideo">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Video" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_D534BE829E32196B}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>

                    <TreeViewItem Tag="SettingsAudio">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="MusicBox" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_BC1B88907D3B748A}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>

                    <TreeViewItem Tag="SettingsSubtitles" IsExpanded="True">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClosedCaption" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_0EE695BDEB26A296}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>

                        <TreeViewItem
                            Header="{loc:Text Key=Text_54DFF361FCD147DF}"
                            Tag="SettingsSubtitlesPS"
                            FontSize="14"
                            FontWeight="Normal" />

                        <TreeViewItem
                            Header="{loc:Text Key=Text_BFA8070BD95ECF82}"
                            Tag="SettingsSubtitlesASR"
                            FontSize="14"
                            FontWeight="Normal" />

                        <TreeViewItem
                            Header="{loc:Text Key=Text_5E5BEA5354E3F22E}"
                            Tag="SettingsSubtitlesOCR"
                            FontSize="14"
                            FontWeight="Normal" />

                        <TreeViewItem
                            Header="{loc:Text Key=Text_8FE147696FBF47F3}"
                            Tag="SettingsSubtitlesTrans"
                            FontSize="14"
                            FontWeight="Normal" />

                        <TreeViewItem
                            Header="{loc:Text Key=Text_8F9C8EE90225DB8C}"
                            Tag="SettingsSubtitlesAction"
                            FontSize="14"
                            FontWeight="Normal" />
                    </TreeViewItem>

                    <TreeViewItem Tag="SettingsKeys" IsExpanded="True">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Keyboard" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_F0D66A79C138E951}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>

                        <TreeViewItem
                            Header="{loc:Text Key=Text_B1A1E8E3CF7C522E}"
                            Tag="SettingsKeysOffset"
                            FontSize="14"
                            FontWeight="Normal" />
                    </TreeViewItem>

                    <TreeViewItem Tag="SettingsMouse">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Mouse" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_55C1520824A84D75}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>

                    <TreeViewItem Tag="SettingsThemes">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PaletteOutline" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_43AE3265B99F2F34}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>

                    <TreeViewItem Tag="SettingsPlugins">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Puzzle" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_9514B7FF4860EAD7}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>

                    <TreeViewItem Tag="SettingsAbout">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Information" Width="24" Height="24" Margin="0 0 8 0" />
                                <TextBlock Text="{loc:Text Key=Text_4EFCA0D10C5FEB8E}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                </TreeView>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl
                    x:Name="SettingsContent"
                    Grid.Row="0"
                    FontSize="14"
                    Margin="10">
                    <ContentControl.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>

                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                        </Style>

                        <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignGroupBox}">
                            <Setter Property="Margin" Value="8" />

                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding}"
                                            FontWeight="Bold"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Margin" Value="0 0 0 8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DockPanel">
                            <Setter Property="Margin" Value="0 0 0 8"/>
                        </Style>

                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="Padding" Value="3" />
                        </Style>
                    </ContentControl.Resources>
                    <settings:SettingsPlayer />
                </ContentControl>

                <StackPanel
                    Orientation="Horizontal"
                    Margin="15"
                    HorizontalAlignment="Right"
                    Grid.Row="1">
                    <Button
                        Content="{loc:Text Key=Text_390DD9F6966D7E83}"
                        Command="{Binding CmdCloseDialog}"
                        CommandParameter="Save"
                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                        ToolTip="{loc:Text Key=Text_761839AD7B92F662}"
                        Margin="0 0 10 0"/>

                    <!--TODO: L: Implement cancel feature-->
                    <Button
                        Content="{loc:Text Key=Text_7D9EB7ACB13E2462}"
                        Command="{Binding CmdCloseDialog}"
                        CommandParameter="Close"
                        ToolTip="{loc:Text Key=Text_6EF9FF47B4AEA74C}" />
                </StackPanel>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
